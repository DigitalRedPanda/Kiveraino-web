<!DOCTYPE html>
<html>
	<header>
		<title>404 Not Found</title>
		<link rel="stylesheet" href="css/404.css">
	</header>
	<body>
		<div>
			<h1>404 Not Found</h1>
			<p>{{url}} Does Not Exist</p>
		</div>

	</body>
	<style>
		:root {
		  --background: #0b0e0f;
		}
		body  {
		  background-color: var(--background);
		  opacity: 0;
		  transition: opacity 100ms ease-in;
		}

		.loaded {
		  opacity: 1;
		}
	</style>

	<script src="/js/fouc-handler.js"></script>
</html>

